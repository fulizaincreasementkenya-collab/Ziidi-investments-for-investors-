# Server
PORT=3000
NODE_ENV=production
APP_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional authorized M-PESA Daraja integration
# Keep these values server-side only. Never put them in public JS.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://YOUR-RENDER-SERVICE.onrender.com/api/mpesa/callback
ENABLE_PAYMENTS=false

# Use CustomerPayBillOnline for a PayBill collection account.
# Only enable payments after you have an authorized merchant account
# and the appropriate permissions/agreements for your service.
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline